# Copy this file to .env and fill in what you need.
# Loaded automatically by the CLI entry points (`import mr_deed.run`, see src/mr_deed/run/__init__.py)
# and by direnv (see .envrc). Importing the library itself (`import mr_deed`) never touches the environment.

# --- Model provider API keys (read directly by litellm; set whichever you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# --- mr-deed settings (see src/mr_deed/__init__.py and models/__init__.py) ---
# Default model for run scripts when -m/--model is omitted.
MRDEED_MODEL_NAME=
# Skip the interactive `mini-extra config setup` first-run prompt.
MRDEED_CONFIGURED=true
# Silence the startup version banner (useful for scripted/test runs).
MRDEED_SILENT_STARTUP=1
